table latency_waterfall
	lineageTag: a6cd24d6-27a7-50a0-82b1-6e440b0e12cc

	measure 'Stage median (s)' = SWITCH(SELECTEDVALUE(latency_stage[stage]), "Feed delay", [Feed delay, median (s)], "Ingest", [Ingest, median (s)], "Windowing", [Windowing, median (s)], "Forecast", [Forecast, median (s)], "Alert", [Alert, median (s)], "Human approval", [Human approval, median (s)], "Delivery", [Delivery, median (s)])
		formatString: 0.000
		lineageTag: 69401609-c06b-5f13-b71c-2249bee5d190

	measure 'Feed delay, median (s)' = MEDIAN(latency_waterfall[feed_delay_s])
		formatString: 0.000
		lineageTag: 7036679c-26e0-5dbe-9fc5-be24c73e5864

	measure 'Ingest, median (s)' = MEDIAN(latency_waterfall[ingest_s])
		formatString: 0.000
		lineageTag: 9fcf632d-38ae-5e12-88c5-6a2e97530c0b

	measure 'Windowing, median (s)' = MEDIAN(latency_waterfall[windowing_s])
		formatString: 0.000
		lineageTag: c615c518-136e-56b0-9f4b-1c6a3648d635

	measure 'Forecast, median (s)' = MEDIAN(latency_waterfall[forecast_s])
		formatString: 0.000
		lineageTag: 2dbb5882-f69c-54e6-b5a7-2e9be529baa1

	measure 'Alert, median (s)' = MEDIAN(latency_waterfall[alert_s])
		formatString: 0.000
		lineageTag: 46bdc4e3-8a15-5398-87d3-3cc0da3d3b96

	measure 'Human approval, median (s)' = MEDIAN(latency_waterfall[human_s])
		formatString: 0.000
		lineageTag: 99b3061d-8334-5b7d-ae7f-67d893a2fdb7

	measure 'Delivery, median (s)' = MEDIAN(latency_waterfall[delivery_s])
		formatString: 0.000
		lineageTag: 81b2db8d-b432-50db-bea7-d886670c1900

	measure 'Total net of feed delay, median (s)' = MEDIAN(latency_waterfall[net_total_s])
		formatString: 0.000
		lineageTag: 0188151a-843a-5f25-ba10-4b864d805e63

	measure 'Total gross, median (s)' = MEDIAN(latency_waterfall[gross_total_s])
		formatString: 0.000
		lineageTag: e4ef25ad-9bf3-57ab-9566-44525e645655

