table evaluation_runs
	lineageTag: 6dacf97b-be89-5415-b8ae-44cc08199f64

	measure 'Title forecast evaluation' = "Forecast Evaluation | data_source: " & SELECTEDVALUE(evaluation_runs[data_source], "select one") & " | " & SELECTEDVALUE(evaluation_runs[run_label], "select one") & " | horizon " & SELECTEDVALUE(evaluation_runs[horizon_h], 0) & " h | forecast of crossing an official category; lead time gross and net of feed delay in notes"
		lineageTag: 36b9c399-9c43-5a90-a8b4-6ec80d70ca6a

	measure 'F1 (mean of rows)' = AVERAGE(evaluation_runs[f1])
		formatString: 0.00
		lineageTag: 246c5f8d-2a68-5342-a7f6-067141bd7f63

	measure 'False alarms' = SUM(evaluation_runs[false_alarms])
		formatString: 0
		lineageTag: 41d37a16-eeae-5e69-b001-ce62452a55ec

	measure 'Lead time, median of rows (h)' = MEDIAN(evaluation_runs[median_lead_time_h])
		formatString: 0.00
		lineageTag: eca38f5c-53f0-50b8-b8a5-ab2c8662f934

	measure 'Drill recovery, median (s)' = CALCULATE(MEDIAN(evaluation_runs[recovery_time_s]), evaluation_runs[status] = "passed")
		formatString: 0.0
		lineageTag: f010e8d3-2f35-5b16-b091-ad93a00f7b19

	measure 'Drills failed' = CALCULATE(COUNTROWS(evaluation_runs), evaluation_runs[status] = "failed")
		formatString: 0
		lineageTag: e5cadfd6-3463-595f-80c1-a993ade51f08

