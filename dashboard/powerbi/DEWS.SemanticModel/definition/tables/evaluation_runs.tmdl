	partition evaluation_runs = m
		mode: directQuery
		source =
				let
					Source = PostgreSQL.Database("localhost:5432", "disaster_warning"),
					Data = Source{[Schema="public",Item="evaluation_runs"]}[Data]
				in
					Data

