# Copy to .env (git-ignored) and fill in. Read by the notifier (Phase 6a).
NOTIFY_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Agents (Phase 6b): LLM_PROVIDER = groq | gemini | ollama | none
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Reasoning budget for openai/gpt-oss-* (low | medium | high; ignored for other models). low halved tokens and time, no extra revisions
GROQ_REASONING_EFFORT=low
# On a Groq 429 the call waits once for the reset hint (<= 20 s) and retries Groq; a longer hint or any other failure:
# the same call is retried once on LLM_FALLBACK (gemini | groq | none), then template v1 stays
LLM_FALLBACK=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Reviewer's LLM judge, independent of the writer (gemini | groq | ollama | none). JUDGE_MODEL optional (default: that
# provider's model above). A failed judge call: deterministic checks decide, run says "judge unavailable"; it is
# retried on JUDGE_FALLBACK only when set (none | groq | gemini | ollama), never on LLM_FALLBACK
JUDGE_PROVIDER=gemini
JUDGE_MODEL=
JUDGE_FALLBACK=none
# Optional local provider (not needed): OLLAMA_MODEL=qwen2.5:7b, OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# Optional tracing (LangSmith Developer plan)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
