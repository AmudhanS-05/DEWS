# Copy to .env (git-ignored) and fill in. Read by the notifier (Phase 6a).
NOTIFY_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Agents (Phase 6b): LLM_PROVIDER = groq | gemini | ollama | none
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# On a Groq failure or rate limit the same call is retried once on LLM_FALLBACK (gemini | groq | none), then template v1 stays
LLM_FALLBACK=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional local provider (not needed): OLLAMA_MODEL=qwen2.5:7b, OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# Optional tracing (LangSmith Developer plan)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
